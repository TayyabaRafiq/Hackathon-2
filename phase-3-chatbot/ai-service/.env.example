# Cohere API
# SECURITY: Rotate API keys quarterly for security best practices
# Steps to rotate:
#   1. Generate new API key at https://dashboard.cohere.com/api-keys
#   2. Update COHERE_API_KEY in production environment
#   3. Restart AI service to load new key
#   4. Revoke old API key in Cohere dashboard after verification
#   5. Document rotation date in security log
# Last rotation: [YYYY-MM-DD]
COHERE_API_KEY="your-cohere-api-key-here-get-from-dashboard-cohere-com"
COHERE_MODEL="command-r"  # or "command-r-plus" for higher quality

# Backend Express URL (for MCP tool calls)
BACKEND_URL="http://localhost:8000"

# Server
PORT=8001
LOG_LEVEL="info"
